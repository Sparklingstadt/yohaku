#!/bin/sh
set -eu
# コンテナのファイルシステムは一時的。キャッシュとSQLiteは /tmp に置く。
# 注意: SQLiteのデータはコンテナの再起動・再デプロイで消える（デモ用途）。
export BOOTSNAP_CACHE_DIR=/tmp/bootsnap
export SQLITE_DATABASE_PATH="${SQLITE_DATABASE_PATH:-/tmp/production.sqlite3}"
mkdir -p /tmp/bootsnap
# 新しいDBなら作成・スキーマ読込・seed（商品データ）まで行う。
bin/rails db:prepare
exec bin/rails server -b 0.0.0.0 -p "${PORT:-3000}" -P /tmp/puma.pid
